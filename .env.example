# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (local Postgres via docker-compose)
DATABASE_URL=postgresql+psycopg2://crypto:crypto@localhost:5432/crypto_intelligence

# Sync scheduler
SYNC_INTERVAL_HOURS=24

# --- Feature 1 placeholders: NOT connected yet, do not populate/use until CMC integration is approved ---
COINMARKETCAP_API_KEY=
COINMARKETCAP_BASE_URL=https://pro-api.coinmarketcap.com

# --- X (Twitter) post caching: third-party scraper API (e.g. Apify), 4h Postgres cache per coin ---
# Populate with a real Apify API token + actor id to enable; left empty, SocialService
# just skips the scrape and serves whatever's already cached (or nothing on a first-ever miss).
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apidojo~tweet-scraper
SOCIAL_CACHE_TTL_HOURS=4

# Local dev only: automatically log this account in on localhost (no login step).
# Ignored unless the request Host is localhost. Never set on a server.
# DEV_AUTO_LOGIN_EMAIL=you@example.com

# Private mode: only these comma-separated accounts can log in, sign-up is closed,
# and every page sends a logged-out visitor to /login. Leave unset for an open site.
# ALLOWED_LOGIN_EMAILS=you@example.com

# Forex Factory page (/tools/cpi-fomc). Both optional: the page works without them.
# Free BLS registration key (https://data.bls.gov/registrationEngine/): raises the BLS limit from 25 to 500 requests a day.
BLS_API_KEY=
# Free FRED API key (https://fredaccount.stlouisfed.org/apikeys): gives the CPI and jobs report dates weeks ahead (month list, 7-day/3-day Telegram reminders).
FRED_API_KEY=
# Apify token (console.apify.com > Settings > Integrations): lets the ForexFactory actor fill actual values the free sources cannot (pay per event, 25 free rows per run).
APIFY_TOKEN=

# MEXC portfolio (/portfolio + the coin page's "Your MEXC" box), read-only. Create the key on MEXC with ONLY
# Spot "View Account Details" + "View Order Details" ticked and link it to this server's IP (unlinked keys expire
# after 90 days). Never commit real values: .env is gitignored.
MEXC_API_KEY=
MEXC_API_SECRET=
# Comma-separated login emails that may see the MEXC data (empty = nobody).
MEXC_VIEWER_EMAILS=
# Local UI testing only: serve made-up MEXC data instead of calling MEXC.
# MEXC_FIXTURE_FILE=tests/fixtures/mexc_demo.json

# Optional: Google Cloud Translation API key (official). When set, the news reader's EN | MY tabs translate the AI summary with Google Translate (the free AI models stay as the fallback).
GOOGLE_TRANSLATE_API_KEY=
